# Supabase project URL and publishable (public) key.
# Get these from Supabase Dashboard > Project Settings > API.
# NEVER commit the actual .env file or the service_role/secret key.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Canonical production URL, used for email links that must work regardless of
# where the request was triggered from (e.g. an Admin resetting their own
# password while testing on localhost should still get a production link).
# Leave unset locally so password-reset links keep pointing at localhost for
# local testing; set this in the production deploy's env vars (e.g. Vercel).
VITE_APP_URL="https://portal.tlconceptsltd.com"
