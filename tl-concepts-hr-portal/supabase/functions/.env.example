ALLOWED_ORIGINS="https://hr-portal-tl.vercel.app,http://127.0.0.1:3000"
RESEND_API_KEY="re_..."
NOTIFICATION_FROM_EMAIL="HR Portal <hr@example.com>"
# Optional. Defaults to the Inter variable font used by the payroll table.
PAYSLIP_FONT_URL="https://raw.githubusercontent.com/google/fonts/main/ofl/inter/Inter%5Bopsz%2Cwght%5D.ttf"
